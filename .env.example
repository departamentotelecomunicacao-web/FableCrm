# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados PostgreSQL
DATABASE_URL=postgres://fablecrm:fablecrm@localhost:5432/fablecrm

# Autenticação JWT (troque em produção!)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES=8h

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Backup automático (pg_dump)
# Em hospedagens sem pg_dump/disco persistente (Render+Neon), use BACKUP_ENABLED=false
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30

# Notificações automáticas (cron)
NOTIFY_CRON=0 * * * *
